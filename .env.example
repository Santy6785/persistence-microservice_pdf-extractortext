# =============================================================================
# Variables de entorno del microservicio persistence
# Copia este archivo a .env y ajusta los valores según tu entorno.
# =============================================================================

# --- Entorno general ---------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# --- Logging -----------------------------------------------------------------
# Nivel de logs. Valores permitidos: debug, info, warn, error (case-insensitive).
# 'warn' se normaliza automáticamente a WARNING. Cualquier otro valor rechaza
# la aplicación con un ValidationError que nombra a la variable LOG_LEVEL.
LOG_LEVEL=info

# --- Límites de payload ------------------------------------------------------
MAX_PAYLOAD_SIZE_BYTES=14680064

# --- MongoDB -----------------------------------------------------------------
# MONGODB_URI es obligatoria: no tiene valor por defecto. No commitees credenciales.
MONGODB_URI=mongodb://admin:password@localhost:27017/persistence_db?authSource=admin
MONGODB_DB=persistence_db
MONGODB_COLLECTION=documents
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_OPERATION_TIMEOUT_MS=10000
MONGODB_PING_TIMEOUT_MS=2000
