# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Security / Limits
MAX_PAYLOAD_SIZE_BYTES=26214400

# Database Configuration (PostgreSQL)
POSTGRES_DB=persistence_db
POSTGRES_USER=persistence_user
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+asyncpg://persistence_user:replace-with-a-local-development-password@localhost:5432/persistence_db
TEST_DATABASE_URL=postgresql+asyncpg://persistence_user:replace-with-a-local-development-password@localhost:5433/persistence_test_db
