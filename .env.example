# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Security / Limits
MAX_PAYLOAD_SIZE_BYTES=14680064

# MongoDB (única base de persistencia) — credenciales solo por variables de entorno
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=persistence_db
MONGODB_COLLECTION=documents
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000

# Docker Compose (credenciales de root de Mongo)
MONGODB_ROOT_USERNAME=replace-with-a-local-development-username
MONGODB_ROOT_PASSWORD=replace-with-a-local-development-password
