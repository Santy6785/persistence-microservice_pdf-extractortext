# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Security / Limits
MAX_PAYLOAD_SIZE_BYTES=14680064

# MongoDB (única base de persistencia) — credenciales solo por variables de entorno
MONGODB_URI=mongodb://replace-user:replace-password@mongodb:27017/?authSource=admin
MONGODB_DB=persistence_db
MONGODB_COLLECTION=documents
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
# Timeout de cada operación de datos (ms). Debe ser mayor que MONGODB_SERVER_SELECTION_TIMEOUT_MS.
MONGODB_OPERATION_TIMEOUT_MS=10000

# Docker Compose (credenciales de root de Mongo)
MONGODB_ROOT_USERNAME=replace-user
MONGODB_ROOT_PASSWORD=replace-password
