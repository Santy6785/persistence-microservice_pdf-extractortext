# Variables de entorno del microservicio persistence.
# Copiá este archivo a .env y completá los valores. No commitees .env.

APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# Nivel de logs: debug | info | warn | error (no distingue mayúsculas).
# 'warn' se normaliza a WARNING. Un valor inválido hace fallar el arranque.
LOG_LEVEL=info

MAX_PAYLOAD_SIZE_BYTES=14680064

# Obligatoria, sin valor por defecto. Completar en .env con la URI de MongoDB.
MONGODB_URI=
MONGODB_DB=persistence_db
MONGODB_COLLECTION=documents
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_OPERATION_TIMEOUT_MS=10000
MONGODB_PING_TIMEOUT_MS=2000
TRACE_MAX_BODY_BYTES=1048576

# Credenciales root de Mongo para docker compose. Completar en .env.
MONGODB_ROOT_USERNAME=
MONGODB_ROOT_PASSWORD=